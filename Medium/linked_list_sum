    def addTwoNumbers(self, l1: ListNode | None, l2: ListNode | None) -> ListNode | None:
        soln = ListNode()
        curr = soln
        carry = 0
        while l1 and l2:

            if carry == 1:
                sum = l1.val + l2.val + carry
                carry = 0
            else:
                sum = l1.val + l2.val

            if sum > 9:
                sum -= 10
                carry = 1
            curr.val = sum
            if (l1.next or l2.next):
                curr.next = ListNode()
                curr = curr.next
            l1 = l1.next
            l2 = l2.next
        
        while l1:
            sum = l1.val + carry
            carry = 0
            if sum > 9:
                sum -= 10
                carry = 1
            curr.val = sum
            if l1.next:
                curr.next = ListNode()
                curr = curr.next
            l1 = l1.next
    

        while l2:
            sum = l2.val + carry
            carry = 0
            if sum > 9:
                sum -= 10
                carry = 1
            curr.val = sum
            if l2.next:
                curr.next = ListNode()
                curr = curr.next
            l2 = l2.next

        if carry == 1:
            curr.next = ListNode(1)

        return soln

